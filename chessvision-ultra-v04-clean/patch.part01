+        final float[] b=center(m.to,rect,whiteBottom);
+        // Keep the tap safely inside the square. v0.3 used 7.5%, which was
+        // unnecessarily large when the detected board was close to an inset.
+        final float jitter=cell*.025f;
+        a[0]+=rand(jitter);a[1]+=rand(jitter);
+        b[0]+=rand(jitter);b[1]+=rand(jitter);
+
+        tap(a[0],a[1],72+random.nextInt(35),ok1->{
+            if(!ok1){finish(cb,false);return;}
