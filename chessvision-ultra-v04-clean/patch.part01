+
+    void playMoveDrag(Move m,BoardRect rect,boolean whiteBottom,Callback cb){
+        final float cell=rect.cell();
+        final float[] a=center(m.from,rect,whiteBottom);
+        final float[] b=center(m.to,rect,whiteBottom);
+        final float jitter=cell*.018f;
+        a[0]+=rand(jitter);a[1]+=rand(jitter);
+        b[0]+=rand(jitter);b[1]+=rand(jitter);
+
+        Path p=new Path();
+        p.moveTo(a[0],a[1]);
+        // A real line, rather than teleporting from one tap to another, is
+        // accepted by drag-only chess boards.
