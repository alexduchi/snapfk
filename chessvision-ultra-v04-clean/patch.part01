+            @Override public void onCompleted(GestureDescription d){if(once.compareAndSet(false,true))cb.done(true);}
+            @Override public void onCancelled(GestureDescription d){if(once.compareAndSet(false,true))cb.done(false);}
+        };
+        boolean accepted=false;
+        try{accepted=service.dispatchGesture(g,result,main);}catch(Throwable ignored){}
+        if(!accepted && once.compareAndSet(false,true))cb.done(false);
+    }
+
+    private void finish(Callback cb,boolean ok){try{cb.done(ok);}catch(Throwable ignored){}}
